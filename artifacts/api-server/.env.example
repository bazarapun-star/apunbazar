# ============================================
# DATABASE — Supabase Connection Pooling URL
# Project → Settings → Database → Connection Pooling → URI
# ============================================
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.XXXXXXXX.supabase.co:6543/postgres?pgbouncer=true"

# ============================================
# SERVER
# ============================================
PORT=8080
NODE_ENV=production

# ============================================
# ADMIN AUTH
# Generate hash: node -e "const b=require('bcrypt'); b.hash('YOUR_PASSWORD',12).then(console.log)"
# Generate JWT:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================
ADMIN_EMAIL=admin@apunbazar.com
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=

# ============================================
# RAZORPAY
# ============================================
RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_KEY_SECRET=xxxx

# ============================================
# CORS — Apne Vercel domain se update karo
# ============================================
ALLOWED_ORIGINS=https://apunbazar.vercel.app,https://www.apunbazar.com
